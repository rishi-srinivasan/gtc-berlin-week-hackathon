# Secrets only. Models/providers/URLs live in config.toml (profiles: local, hackathon).
# Any variable set here or in the shell overrides config.toml, e.g. TEACHER_MODEL=gemma4:12b.
PII_PROFILE=local            # local | hackathon

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# hackathon profile only
ANTHROPIC_API_KEY=           # or OPENAI_API_KEY
HF_TOKEN=
RUNPOD_API_KEY=
STUDENT_API_KEY=             # the --api-key given to vLLM on the pod
TEACHER_PRICE_IN_PER_M=      # optional: cloud cost reporting in `make eval` (USD per 1M tokens)
TEACHER_PRICE_OUT_PER_M=

