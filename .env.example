# The ONLY config file. `make setup` copies it to .env; fill the blanks on hackathon day.
# Every model role is any OpenAI-compatible API (or PROVIDER=anthropic). See README "Configure".

# --- Langfuse (organisers share keys) ---------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Teacher: big model that labels data / gives the baseline -------------------------
TEACHER_PROVIDER=openai          # openai (any OpenAI-compatible) | anthropic
TEACHER_MODEL=
TEACHER_BASE_URL=                # empty = api.openai.com
TEACHER_API_KEY=
TEACHER_EXTRA=                   # optional JSON request params, e.g. {"temperature": 0}
TEACHER_PRICE_IN_PER_M=          # optional, USD per 1M tokens -> cost/1k msgs in `make eval`
TEACHER_PRICE_OUT_PER_M=

# --- Student: the distil-trained small model, hosted by distil labs (README step 5) ------
STUDENT_BASE_URL=https://inference.distillabs.ai/v1
STUDENT_MODEL=                   # the unique endpoint name printed by `distil inference-endpoint create-from-deployment`
STUDENT_API_KEY=                 # secret in <key-name>.json from `distil api-keys create`
STUDENT_VERSION=v1               # bump per retrain; becomes a Langfuse tag
STUDENT_EXTRA={"chat_template_kwargs": {"enable_thinking": false}}   # copy sampling/thinking flags from model_client.py

# --- Frontier: the LLM that answers the redacted text in the gateway demo -------------
FRONTIER_PROVIDER=openai
FRONTIER_MODEL=
FRONTIER_BASE_URL=
FRONTIER_API_KEY=

# --- distil labs (training config written by `make distil-prep`) -----------------------
DISTIL_TEACHER=openai.gpt-oss-120b   # must be from distil's model catalog
DISTIL_STUDENT=Qwen3-1.7B

# --- Optional ---------------------------------------------------------------------------
HF_TOKEN=                        # higher Hugging Face rate limits; needed for gated base models
