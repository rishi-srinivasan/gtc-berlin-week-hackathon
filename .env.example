# Langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Providers: teacher ollama|anthropic|openai, student ollama|runpod (default ollama = local, free)
TEACHER_PROVIDER=ollama
STUDENT_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# Cloud teacher / frontier LLM (only for anthropic / openai)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TEACHER_MODEL=
FRONTIER_MODEL=
# Optional cost reporting for `make eval` (USD per 1M tokens)
TEACHER_PRICE_IN_PER_M=
TEACHER_PRICE_OUT_PER_M=
# Hugging Face (rate limits / gated base models)
HF_TOKEN=
# Runpod + served student (see scripts/runpod_serve.md)
RUNPOD_API_KEY=
STUDENT_BASE_URL=
# ollama: default qwen3:1.7b (pii-student after import). runpod: the adapter name, `model`
STUDENT_MODEL=
STUDENT_API_KEY=
STUDENT_VERSION=v0

# Root demo agent (agent.py): any OpenAI-compatible endpoint
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-5-mini
